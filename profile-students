<?php
session_start();
include "db.php";

if (!isset($_SESSION['user']) || !isset($_SESSION['role'])) {
    header("Location: login.php");
    exit();
}
if ($_SESSION['role'] !== "student") {
    header("Location: login.php");
    exit();
}

$user = $_SESSION['email'];
$message = "";

$sql = "SELECT name, email, degree, student_index, batch, username FROM students WHERE email = ?";
$stmt = $conn->prepare($sql);
$stmt->bind_param("s", $user);
$stmt->execute();
$result = $stmt->get_result();

if ($result->num_rows === 1) {
    $row = $result->fetch_assoc();
    $name     = $row['name'];
    $email    = $row['email'];
    $degree   = $row['degree'];
    $indexnum = $row['student_index'];
    $batch    = $row['batch'];
    $username = $row['username'];
} else {
    $name = $email = $degree = $indexnum = $batch = $username = "";
}

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    $name     = trim($_POST['name']);
    $email    = trim($_POST['email']);
    $degree   = trim($_POST['degree']);
    $indexnum = trim($_POST['indexnum']);
    $batch    = trim($_POST['batch']);

    $update_sql = "UPDATE students SET name = ?, email = ?, degree = ?, student_index = ?, batch = ? WHERE email = ?";
    $update_stmt = $conn->prepare($update_sql);
    $update_stmt->bind_param("ssssss", $name, $email, $degree, $indexnum, $batch, $user);

    if ($update_stmt->execute()) {
        $_SESSION['name']   = $name;
        $_SESSION['email']  = $email;
        $_SESSION['user']   = $email;
        $_SESSION['index']  = $indexnum;
        $_SESSION['degree'] = $degree;
        header("Location: dashboard-student.php");
        exit();
    } else {
        $message = "Update failed. Please try again.";
    }
}
